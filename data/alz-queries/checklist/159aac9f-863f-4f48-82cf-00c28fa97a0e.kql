// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 159aac9f-863f-4f48-82cf-00c28fa97a0e
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.storage/storageaccounts' | extend kind = tostring(kind) | where kind =~ 'StorageV2' or kind =~ 'BlobStorage' or kind =~ 'BlockBlobStorage' | extend blobSvcProps = properties.blobServices | project id, name, resourceGroup, subscriptionId, kind,   checkItem='Container Soft Delete' | join kind=leftouter (   resources   | where type =~ 'microsoft.storage/storageaccounts/blobservices'   | extend containerSoftDelete = tostring(properties.containerDeleteRetentionPolicy.enabled)   | extend retentionDays = tostring(properties.containerDeleteRetentionPolicy.days)   | extend parentAccount = tolower(substring(id, 0, indexof(tolower(id), '/blobservices')))   | project parentAccount, containerSoftDelete, retentionDays ) on $left.id == $right.parentAccount | extend compliant = iff(containerSoftDelete =~ 'true', true, false) | project id, name, resourceGroup, subscriptionId, checkItem,   currentValue=strcat('SoftDelete: ', iff(isnotempty(containerSoftDelete), containerSoftDelete, 'Not configured'),     iff(isnotempty(retentionDays), strcat(', Retention: ', retentionDays, ' days'), '')),   expectedValue='Enabled with appropriate retention', compliant
