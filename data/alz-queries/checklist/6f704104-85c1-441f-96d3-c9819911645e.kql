// Source checklist ID: 6f704104-85c1-441f-96d3-c9819911645e
// Vendored at: 2026-05-13T09:27:15+00:00
authorizationresources | where type =~ 'microsoft.authorization/roleassignments' | extend roleId = tostring(properties.roleDefinitionId) | extend principalType = tostring(properties.principalType) | where roleId endswith '8e3af657-a8ff-443c-a75c-2fe8c4bcb635' or roleId endswith '18d7d88d-d35e-4fb5-a5c3-7773c20a72d9' | summarize ownerCount=count() by principalType | project checkItem='Privileged Role Assignments', currentValue=strcat(principalType, ': ', tostring(ownerCount), ' privileged assignments'), expectedValue='Minimal, group-based', compliant=iff(principalType =~ 'Group', true, false)
