// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 6d70ba6c-97be-4995-8904-83845c986cb2
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.keyvault/vaults' | project vaultId = id, vaultName = name, resourceGroup, subscriptionId | join kind=leftouter (resources | where type =~ 'microsoft.keyvault/vaults/certificates' | extend parentVault = tolower(substring(id, 0, indexof(tolower(id), '/certificates'))) | extend certName = name | extend enabled = tostring(properties.attributes.enabled) | extend expires = tostring(properties.attributes.expires) | project parentVault, certName, enabled, expires) on $left.vaultId == $right.parentVault | extend compliant = iff(isnotempty(certName), true, false) | project id=vaultId, name=vaultName, resourceGroup, subscriptionId, checkItem='KV Certificate Management', currentValue=iff(isnotempty(certName), strcat('Cert: ', certName, ', Enabled: ', enabled), 'No certificates'), expectedValue='Certificates managed in Key Vault', compliant
