// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 24d96b30-61ee-4436-a1cc-d6ef08bc574b
// Vendored at: 2026-05-13T09:27:15+00:00
securityresources | where type =~ 'microsoft.security/assessments' | where properties.displayName has 'Endpoint protection'   or properties.displayName has 'endpoint protection'   or properties.displayName has 'Defender for Endpoint'   or properties.displayName has 'Install endpoint protection'   or properties.displayName has 'Machines should have' | extend statusCode = tostring(properties.status.code) | extend assessmentName = tostring(properties.displayName) | extend resourceId = tostring(properties.resourceDetails.Id) | extend compliant = iff(statusCode =~ 'Healthy', true, false) | project id=resourceId, name=tostring(split(resourceId, '/')[-1]),   resourceGroup=tostring(split(resourceId, '/')[4]),   subscriptionId=tostring(split(resourceId, '/')[2]),   checkItem='Endpoint Protection',   assessmentName,   currentValue=strcat('Status: ', statusCode, ' (', assessmentName, ')'),   expectedValue='Healthy', compliant | union (   resources   | where type =~ 'microsoft.compute/virtualmachines/extensions'   | where name has 'MDE' or name has 'EndpointProtection' or name has 'IaaSAntimalware'     or name has 'MicrosoftMonitoringAgent'   | extend parentVM = tostring(split(id, '/extensions/')[0])   | project id=parentVM, name=tostring(split(parentVM, '/')[-1]),     resourceGroup=tostring(split(parentVM, '/')[4]),     subscriptionId=tostring(split(parentVM, '/')[2]),     checkItem='Endpoint Protection Extension',     currentValue=strcat('Extension: ', name, ', Status: ', tostring(properties.provisioningState)),     expectedValue='MDE.Windows/MDE.Linux or IaaSAntimalware installed',     compliant=iff(tostring(properties.provisioningState) =~ 'Succeeded', true, false) )
