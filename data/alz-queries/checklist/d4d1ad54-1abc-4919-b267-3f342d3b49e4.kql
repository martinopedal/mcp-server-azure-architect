// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: d4d1ad54-1abc-4919-b267-3f342d3b49e4
// Vendored at: 2026-05-13T09:27:15+00:00
authorizationresources | where type =~ 'microsoft.authorization/roleassignments' | extend roleId = tostring(properties.roleDefinitionId) | join kind=leftouter (authorizationresources | where type =~ 'microsoft.authorization/roledefinitions' | extend roleName = tostring(properties.roleName) | extend isDataAction = tostring(properties.permissions[0].dataActions) | project roleId=id, roleName, hasDataActions=isnotempty(isDataAction)) on roleId | where hasDataActions == true | summarize dataPlaneRoles=count() | project checkItem='Data Plane RBAC', currentValue=strcat(tostring(dataPlaneRoles), ' data plane role assignments'), expectedValue='Data plane RBAC used', compliant=iff(dataPlaneRoles > 0, true, false)
