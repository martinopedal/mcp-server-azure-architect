// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 89cc5e11-aa4d-4c3b-893d-feb99215266a
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/applicationgateways' | extend wafEnabled = tostring(properties.webApplicationFirewallConfiguration.enabled) | extend firewallPolicyId = tostring(properties.firewallPolicy.id) | extend hasWAF = iff(wafEnabled =~ 'true' or isnotempty(firewallPolicyId), true, false) | project id, name, resourceGroup, subscriptionId,   checkItem='App GW WAF Config',   currentValue=strcat('WAF: ', iff(hasWAF, 'Enabled', 'Disabled'), iff(isnotempty(firewallPolicyId), strcat(', Policy: ', tostring(split(firewallPolicyId, '/')[-1])), '')),   expectedValue='WAF enabled with diagnostic logging', compliant=hasWAF | union (   resources   | where type =~ 'microsoft.cdn/profiles'   | extend skuName = tostring(sku.name)   | extend hasWAF = iff(skuName has 'Premium', true, false)   | project id, name, resourceGroup, subscriptionId,     checkItem='Front Door WAF',     currentValue=strcat('SKU: ', skuName),     expectedValue='Premium SKU for WAF', compliant=hasWAF )
