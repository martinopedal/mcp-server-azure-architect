resources | where type =~ 'microsoft.keyvault/vaults' | extend softDelete=tostring(properties.enableSoftDelete) | extend purgeProtect=tostring(properties.enablePurgeProtection) | extend rbacAuth=tostring(properties.enableRbacAuthorization) | project id, name, resourceGroup, subscriptionId, checkItem='Key Vault Config', currentValue=strcat('SoftDelete: ', iff(isnotempty(softDelete), softDelete, 'N/A'), ', PurgeProtect: ', iff(isnotempty(purgeProtect), purgeProtect, 'N/A'), ', RBAC: ', iff(isnotempty(rbacAuth), rbacAuth, 'N/A')), expectedValue='Separate KVs per app/env, SoftDelete+PurgeProtect', compliant=iff(purgeProtect =~ 'true' and softDelete =~ 'true', true, false)
