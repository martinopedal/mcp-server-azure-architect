// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 9cf5418b-1520-4b7b-add7-88eb28f833e8
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/virtualnetworks' | mv-expand peering = properties.virtualNetworkPeerings | extend peerName = tostring(peering.name) | extend peerState = tostring(peering.properties.peeringState) | extend remoteVnet = tostring(peering.properties.remoteVirtualNetwork.id) | extend allowAccess = tostring(peering.properties.allowVirtualNetworkAccess) | extend compliant = iff(peerState =~ 'Connected', true, false) | project id, name, resourceGroup, subscriptionId,   peeringName=peerName,   checkItem='VNet Peering to Hub',   currentValue=strcat('State: ', peerState, ', Remote: ', tostring(split(remoteVnet, '/')[-1]), ', AllowAccess: ', allowAccess),   expectedValue='Connected peering to hub', compliant
