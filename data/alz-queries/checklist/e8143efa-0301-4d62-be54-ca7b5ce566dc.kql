// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: e8143efa-0301-4d62-be54-ca7b5ce566dc
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/azurefirewalls' | where isempty(properties.virtualHub.id) or isnull(properties.virtualHub.id) | mv-expand ipConfig = properties.ipConfigurations | project name, firewallId=id, resourceGroup, subscriptionId, vNetId=tolower(substring(ipConfig.properties.subnet.id, 0, indexof(ipConfig.properties.subnet.id, '/subnet'))) | join kind=leftouter (resources | where type =~ 'microsoft.network/ddosprotectionplans' | mv-expand vNet=properties.virtualNetworks | project ddosPlanName=name, vNetId=tolower(vNet.id)) on vNetId | extend compliant = iff(isnotempty(ddosPlanName), true, false) | project id=firewallId, name, resourceGroup, subscriptionId, checkItem='DDoS on FW VNet', currentValue=iff(isnotempty(ddosPlanName), strcat('Protected: ', ddosPlanName), 'No DDoS plan'), expectedValue='DDoS plan associated', compliant
