// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 108d5099-a11d-4445-bd8b-e12a5e95412e
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.keyvault/vaults' | extend softDelete = tostring(properties.enableSoftDelete) | extend purgeProtect = tostring(properties.enablePurgeProtection) | extend rbacAuth = tostring(properties.enableRbacAuthorization) | extend secretCount = array_length(properties.accessPolicies) | extend compliant = iff(isnotempty(softDelete) and softDelete =~ 'true', true, false) | project id, name, resourceGroup, subscriptionId, checkItem='Key Vault Usage', currentValue=strcat('SoftDelete: ', iff(isnotempty(softDelete), softDelete, 'N/A'), ', PurgeProtect: ', iff(isnotempty(purgeProtect), purgeProtect, 'N/A'), ', RBAC: ', iff(isnotempty(rbacAuth), rbacAuth, 'N/A')), expectedValue='Key Vault with soft delete and purge protection', compliant
