policyresources | where type =~ 'microsoft.authorization/policyassignments' | extend displayName = tostring(properties.displayName) | where displayName has 'sovereign' or displayName has 'compliance' or displayName has 'regulatory' | project id, name=displayName, checkItem='Sovereignty Policies', currentValue=displayName, expectedValue='Sovereign control policies assigned', compliant=true
