resources | where type =~ 'microsoft.storage/storageaccounts' | extend encryptionSource = tostring(properties.encryption.keySource) | extend compliant = iff(encryptionSource =~ 'Microsoft.Storage', true, false) | project id, name, resourceGroup, subscriptionId, checkItem='Encryption Key Source', currentValue=strcat('KeySource: ', iff(isnotempty(encryptionSource), encryptionSource, 'Not set')), expectedValue='Microsoft.Storage (unless CMK required)', compliant | union (resources | where type =~ 'microsoft.compute/disks' | extend encryptionType = tostring(properties.encryption.type) | extend compliant = iff(encryptionType =~ 'EncryptionAtRestWithPlatformKey', true, false) | project id, name, resourceGroup, subscriptionId, checkItem='Disk Encryption', currentValue=strcat('Type: ', iff(isnotempty(encryptionType), encryptionType, 'Not set')), expectedValue='Platform-managed key (unless CMK required)', compliant)
