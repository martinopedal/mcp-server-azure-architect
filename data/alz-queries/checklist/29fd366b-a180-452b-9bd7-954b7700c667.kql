resources | where type =~ 'microsoft.consumption/budgets' | extend amount = tostring(properties.amount) | extend timeGrain = tostring(properties.timeGrain) | extend notifications = properties.notifications | extend hasNotifications = iff(isnotempty(tostring(notifications)), true, false) | extend compliant = hasNotifications | project id, name, resourceGroup, subscriptionId, checkItem='Budget Alerts', currentValue=strcat('Amount: ', amount, ', TimeGrain: ', timeGrain, ', HasAlerts: ', tostring(hasNotifications)), expectedValue='Budget with alerts configured', compliant
