resources | where type == 'microsoft.network/virtualnetworks/virtualnetworkpeerings' | extend remoteVnetId = tostring(properties.remoteVirtualNetwork.id), localVnetId = substring(id, 0, indexof(id, '/virtualNetworkPeerings/')) | join kind=leftouter (resources | where type == 'microsoft.network/virtualnetworks' | project localVnetId = id, localLocation = location) on localVnetId | join kind=leftouter (resources | where type == 'microsoft.network/virtualnetworks' | project remoteVnetId = id, remoteLocation = location) on remoteVnetId | extend compliant = iff(localLocation == remoteLocation, 1, 0) | project name, id, localLocation, remoteLocation, compliant
