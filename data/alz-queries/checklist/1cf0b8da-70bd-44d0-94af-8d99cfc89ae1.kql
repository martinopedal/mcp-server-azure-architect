// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 1cf0b8da-70bd-44d0-94af-8d99cfc89ae1
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.operationalinsights/workspaces' | extend retention = tostring(properties.retentionInDays) | project id, name, resourceGroup, subscriptionId, checkItem='Central Log Analytics', currentValue=strcat('Workspace: ', name, ', Retention: ', retention, ' days'), expectedValue='Centralized workspace receiving Entra logs', compliant=iff(toint(retention) >= 90, true, false)
