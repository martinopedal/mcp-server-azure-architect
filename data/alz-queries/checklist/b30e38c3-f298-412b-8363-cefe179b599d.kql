// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: b30e38c3-f298-412b-8363-cefe179b599d
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/expressroutecircuits' | extend circuitState = tostring(properties.circuitProvisioningState) | extend serviceProviderState = tostring(properties.serviceProviderProvisioningState) | extend bw = tostring(properties.bandwidthInMbps) | extend compliant = iff(circuitState =~ 'Provisioned' and serviceProviderState =~ 'Provisioned', true, false) | project id, name, resourceGroup, subscriptionId, checkItem='ER Circuit Status', currentValue=strcat('Circuit: ', circuitState, ', Provider: ', serviceProviderState, ', BW: ', bw, 'Mbps'), expectedValue='Provisioned with monitoring', compliant
