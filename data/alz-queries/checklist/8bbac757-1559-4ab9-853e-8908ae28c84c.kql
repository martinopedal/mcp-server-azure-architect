// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 8bbac757-1559-4ab9-853e-8908ae28c84c
// Vendored at: 2026-05-13T09:27:15+00:00
resourcecontainers | where type == 'microsoft.resources/subscriptions' | extend subscriptionId = name, mgmtChainText = tolower(tostring(properties.managementGroupAncestorsChain)) | where mgmtChainText has 'connectivity' | join kind=leftouter (resources | where type in~ ('microsoft.network/virtualwans','microsoft.network/virtualhubs','microsoft.network/expressroutecircuits','microsoft.network/privatednszones','microsoft.network/dnsresolvers') | summarize resourceCount = count() by subscriptionId) on subscriptionId | extend compliant = iff(toint(coalesce(resourceCount, 0)) > 0, 1, 0) | project name, subscriptionId, resourceCount, compliant
