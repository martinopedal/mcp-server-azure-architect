// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 715d833d-4708-4527-90ac-1b142c7045ba
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/azurefirewalls' | extend diagTarget = id | join kind=leftouter (   resources   | where type =~ 'microsoft.insights/diagnosticsettings'   | extend parentId = tolower(substring(id, 0, indexof(tolower(id), '/providers/microsoft.insights')))   | where parentId has 'azurefirewalls'   | extend destType = tostring(properties.logAnalyticsDestinationType)   | project parentId, destType, diagName=name ) on $left.id == $right.parentId | extend compliant = iff(isnotempty(diagName) and destType =~ 'Dedicated', true, false) | project id, name, resourceGroup, subscriptionId,   checkItem='Firewall Diagnostic Settings',   currentValue=iff(isnotempty(diagName), strcat('DiagSettings: ', diagName, ', DestType: ', destType), 'No diagnostic settings'),   expectedValue='Resource-specific destination table', compliant
