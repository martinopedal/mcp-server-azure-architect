resources | where type =~ 'microsoft.keyvault/vaults/keys' | extend enabled = tostring(properties.attributes.enabled) | extend keyType = tostring(properties.kty) | extend rotationPolicy = properties.rotationPolicy | extend hasRotation = iff(isnotempty(tostring(rotationPolicy)), true, false) | extend compliant = hasRotation | project id, name, resourceGroup, subscriptionId, checkItem='Key Rotation Policy', currentValue=strcat('Type: ', keyType, ', Enabled: ', enabled, ', AutoRotate: ', tostring(hasRotation)), expectedValue='Rotation policy configured', compliant
