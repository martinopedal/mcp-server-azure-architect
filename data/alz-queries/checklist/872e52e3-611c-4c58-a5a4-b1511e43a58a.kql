// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 872e52e3-611c-4c58-a5a4-b1511e43a58a
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/virtualnetworks' | mv-expand subnet=properties.subnets | where subnet.name !in~ ('GatewaySubnet','AzureFirewallSubnet','AzureFirewallManagementSubnet','RouteServerSubnet') | extend nsgId=tostring(subnet.properties.networkSecurityGroup.id) | extend compliant = iff(isnotempty(nsgId), true, false) | project id, name, resourceGroup, subscriptionId, subnetName=tostring(subnet.name), checkItem='NSG on Subnet', currentValue=iff(isnotempty(nsgId), tostring(split(nsgId,'/')[-1]), 'No NSG'), expectedValue='NSG attached', compliant
