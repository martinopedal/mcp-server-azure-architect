// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: b1c82a3f-2320-4dfa-8972-7ae4823c8930
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/publicipaddresses' | extend ddosSettings = properties.ddosSettings | extend protectionMode = tostring(ddosSettings.protectionMode) | extend hasDDoS = iff(isnotempty(protectionMode) and protectionMode !~ 'VirtualNetworkInherited', true, false) | project id, name, resourceGroup, subscriptionId,   checkItem='DDoS on Public IP',   currentValue=strcat('Protection: ', iff(isnotempty(protectionMode), protectionMode, 'None/Inherited')),   expectedValue='DDoS logs enabled on protected IPs', compliant=hasDDoS | union (   resources   | where type =~ 'microsoft.network/ddosprotectionplans'   | project id, name, resourceGroup, subscriptionId,     checkItem='DDoS Protection Plan',     currentValue=strcat('Plan exists: ', name),     expectedValue='DDoS Protection Plan deployed', compliant=true )
