// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: 1770a2ac-c194-4e5c-ade4-82939d38a510
// Vendored at: 2026-05-13T09:27:15+00:00
authorizationresources | where type =~ 'microsoft.authorization/roleassignments' | extend roleId = tostring(properties.roleDefinitionId) | where roleId endswith '8e3af657-a8ff-443c-a75c-2fe8c4bcb635' or roleId endswith '18d7d88d-d35e-4fb5-a5c3-7773c20a72d9' | extend scope = tostring(properties.scope) | where scope == '/' or scope startswith '/providers/Microsoft.Management/managementGroups' | summarize adminCount=count() | project checkItem='Platform Admin Count', currentValue=strcat(tostring(adminCount), ' admin assignments at MG/root scope'), expectedValue='Restricted and documented', compliant=iff(adminCount <= 5, true, false)
