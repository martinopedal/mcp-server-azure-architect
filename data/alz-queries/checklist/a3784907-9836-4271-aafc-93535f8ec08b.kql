// Vendored from https://github.com/martinopedal/alz-checklist-queries/blob/e7641beeda0126cc78825f8b77764c379552f3e1/queries/alz_all_queries.json
// Source checklist ID: a3784907-9836-4271-aafc-93535f8ec08b
// Vendored at: 2026-05-13T09:27:15+00:00
resources | where type =~ 'microsoft.network/virtualnetworks' | mv-expand subnet=properties.subnets | where subnet.name !in~ ('GatewaySubnet','AzureFirewallSubnet','RouteServerSubnet','AzureBastionSubnet') | extend rtId=tostring(subnet.properties.routeTable.id) | extend compliant = iff(isnotempty(rtId), true, false) | project id, name, resourceGroup, subscriptionId, subnetName=tostring(subnet.name), checkItem='Route Table on Subnet', currentValue=iff(isnotempty(rtId), tostring(split(rtId,'/')[-1]), 'No route table'), expectedValue='Route table (unless VWAN)', compliant
