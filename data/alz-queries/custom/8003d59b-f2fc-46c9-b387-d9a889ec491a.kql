// Custom query for diagnostics coverage audit
// Author: Atlas (ARG/KQL Engineer)
// Issue: #100
// Citation: ADR-006 custom query provenance pattern

// For each Azure resource in scope, report whether at least one diagnostic setting exists.
// Groups by resource type to identify types with low coverage.
// Joins resources with microsoft.insights/diagnosticsettings to detect coverage gaps.

resources
| where type !~ 'microsoft.insights/diagnosticsettings'
| extend resourceId = tolower(id)
| join kind=leftouter (
    resources
    | where type =~ 'microsoft.insights/diagnosticsettings'
    | extend targetResourceId = tolower(split(id, '/providers/microsoft.insights/diagnosticsettings/')[0])
    | distinct targetResourceId
) on $left.resourceId == $right.targetResourceId
| extend hasDiagnostics = isnotnull(targetResourceId)
| summarize 
    TotalResources = count(),
    ResourcesWithDiagnostics = countif(hasDiagnostics),
    ResourcesWithoutDiagnostics = countif(not(hasDiagnostics)),
    CoveragePercent = round(100.0 * countif(hasDiagnostics) / count(), 2)
    by type
| extend CoverageStatus = case(
    CoveragePercent >= 90, "Good",
    CoveragePercent >= 50, "Medium",
    "Poor"
)
| project 
    ResourceType = type,
    TotalResources,
    ResourcesWithDiagnostics,
    ResourcesWithoutDiagnostics,
    CoveragePercent,
    CoverageStatus
| order by CoveragePercent asc, TotalResources desc
